<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📝 Ripoti Ulaghai"
        android:textColor="@color/text_primary"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Weka maelezo ya ujumbe unaotiliwa shaka"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:layout_marginTop="8dp"/>

    <!-- Phone Number -->
    <EditText
        android:id="@+id/etPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="Weka namba ya simu"
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/text_primary"
        android:background="#1AFFFFFF"
        android:padding="16dp"/>

    <!-- Message -->
    <EditText
        android:id="@+id/etMessage"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="16dp"
        android:hint="Weka ujumbe unaotiliwa shaka"
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/text_primary"
        android:background="#1AFFFFFF"
        android:padding="16dp"
        android:gravity="top"/>

    <!-- Result TextView -->
    <TextView
        android:id="@+id/tvResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text=""
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:padding="12dp"
        android:background="#1AFFFFFF"/>

    <!-- Analyze Button -->
    <Button
        android:id="@+id/btnAnalyze"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:text="🔍 Chambua"
        android:textColor="@color/bg_dark"
        android:backgroundTint="@color/primary"
        android:textSize="16sp"
        android:textStyle="bold"/>

    <!-- Report Button -->
    <Button
        android:id="@+id/btnReport"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:text="🚨 Ripoti"
        android:textColor="@color/text_primary"
        android:backgroundTint="#FF6B6B"
        android:textSize="16sp"
        android:textStyle="bold"/>

    <!-- Quick Report Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ripoti Haraka"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnReportTCRA"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="TCRA"
            android:textColor="@color/bg_dark"
            android:backgroundTint="@color/accent_warning"
            android:textSize="12sp"/>

        <Button
            android:id="@+id/btnReportNetwork"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Network"
            android:textColor="@color/bg_dark"
            android:backgroundTint="@color/primary"
            android:textSize="12sp"/>
    </LinearLayout>

</LinearLayout>